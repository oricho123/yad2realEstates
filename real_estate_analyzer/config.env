# Real Estate Analyzer Environment Configuration
# ==============================================
# This file contains environment variables for the Real Estate Analyzer application
# Copy the values you want to override to a .env file in the same directory

# Debug and Development Settings
# Set to 'true' to enable debug mode, 'false' for production
DEBUG=true

# Logging Configuration
# Valid levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# Server Configuration
# Host to bind the web server to
HOST=127.0.0.1

# Port for the web server
PORT=8051

# Production Gunicorn Settings
# Number of worker processes (default: CPU cores * 2 + 1)
# WORKERS=4
# Worker class options:
#   - sync: Default, synchronous workers (most compatible)
#   - gthread: Threaded workers for I/O bound apps (recommended for Dash)
#   - gevent: Async workers (requires: pip install gevent)
#   - eventlet: Async workers (requires: pip install eventlet)
# WORKER_CLASS=gthread
# Number of threads per worker (only for gthread worker class)
# THREADS=2
# Maximum concurrent connections per worker
# WORKER_CONNECTIONS=1000
# Request timeout in seconds
# TIMEOUT=120

# Cache Configuration
# Enable/disable caching
CACHE_ENABLED=true

# Cache timeout in seconds (300 = 5 minutes)
CACHE_TIMEOUT=300

# API Configuration (optional overrides)
# Uncomment and modify these if you need to override defaults:
# REQUEST_TIMEOUT=30
# RATE_LIMIT_DELAY=1.0
# MAX_CONCURRENT_REQUESTS=5
# BATCH_SIZE=1000

# Development Notes:
# ==================
# - Set DEBUG=false for production deployment
# - Use LOG_LEVEL=DEBUG for verbose logging during development
# - Adjust PORT if 8051 is already in use
# - Set CACHE_ENABLED=false if you want to disable caching during development
# - Copy this file to .env to automatically load these settings 